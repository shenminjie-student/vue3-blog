{
  "name": "vue3-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "struct@杰构体的静态个人博客：个人介绍、Markdown 博客与电影清单",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && vite build",
    "preview": "vite preview",
    "content:check": "node scripts/check-content.mjs",
    "new:post": "node scripts/new-post.mjs",
    "covers": "node scripts/generate-covers.mjs",
    "deploy": "npm run build && echo shenminjie.online > dist/CNAME && gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "gh-pages": "^6.3.0",
    "vite": "^8.3.0"
  }
}
